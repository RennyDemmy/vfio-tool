#!/usr/bin/env bash

# Ensure the script is run as root
if [ "$EUID" -ne 0 ]; then
  echo "Error: This script must be run as root."
  exit 1
fi

VFIO_CONF="/etc/modprobe.d/vfio.conf"
GRUB_FILE="/etc/default/grub"

# ==========================================
# FUNCTION: SETUP / BIND VFIO
# ==========================================
setup_vfio() {
    local vfio_ids=""
    
    echo ""
    echo "--- 1. Select CPU Type ---"
    echo "Which CPU does your system have?"
    echo "  1) AMD"
    echo "  2) Intel"
    read -p "Select CPU [1-2]: " cpu_idx

    case "$cpu_idx" in
        1) iommu_arg="amd_iommu=on iommu=pt" ;;
        2) iommu_arg="intel_iommu=on iommu=pt" ;;
        *) echo "Invalid selection. Returning to menu."; sleep 2; return ;;
    esac

    echo ""
    echo "--- 2. Select Bootloader ---"
    echo "Which bootloader are you using?"
    echo "  1) GRUB (Standard on Ubuntu/Debian, Fedora, Mint, Gentoo)"
    echo "  2) systemd-boot (Standard on Pop!_OS, common on Arch)"
    echo "  3) Other / Do it manually"
    read -p "Select Bootloader [1-3]: " bootloader_idx

    case "$bootloader_idx" in
        1|2|3) ;;
        *) echo "Invalid selection. Returning to menu."; sleep 2; return ;;
    esac

    echo ""
    echo "Scanning for PCI devices..."
    echo ""

    # --- 3. Select the GPU ---
    mapfile -t gpu_list < <(lspci -nn | grep -iE "VGA|3D")

    echo "AVAILABLE GPUs:"
    if [ ${#gpu_list[@]} -gt 0 ]; then
        for i in "${!gpu_list[@]}"; do
            echo "  $i) ${gpu_list[$i]}"
        done
    else
        echo "  (No GPUs found)"
    fi
    echo "  n) None (Do not pass through a GPU)"

    echo ""
    read -p "Select the number of the GPU to pass through [n]: " gpu_idx

    if [[ "$gpu_idx" =~ ^[0-9]+$ ]] && [ -n "${gpu_list[$gpu_idx]}" ]; then
        gpu_line="${gpu_list[$gpu_idx]}"
        gpu_pci_addr=$(echo "$gpu_line" | awk '{print $1}')
        gpu_id=$(echo "$gpu_line" | grep -oE '\[[0-9a-fA-F]{4}:[0-9a-fA-F]{4}\]' | tr -d '[]' | head -n 1)

        echo "-> Selected GPU: $gpu_pci_addr (ID: $gpu_id)"
        vfio_ids="$gpu_id"

        ident_count=$(lspci -nn | grep -oE "\[$gpu_id\]" | wc -l)
        if [ "$ident_count" -gt 1 ]; then
            echo "WARNING: Multiple devices found with ID $gpu_id."
            echo "Using the 'ids=' method will assign ALL identical GPUs to VFIO."
        fi

        # --- Select the Audio Device (Only if GPU was selected) ---
        echo ""
        echo "AVAILABLE AUDIO DEVICES:"
        mapfile -t audio_list < <(lspci -nn | grep -i "Audio")

        gpu_bus_prefix=$(echo "$gpu_pci_addr" | cut -d'.' -f1)

        for i in "${!audio_list[@]}"; do
            if [[ "${audio_list[$i]}" == *"$gpu_bus_prefix"* ]]; then
                echo "  $i) ${audio_list[$i]}  <-- (Recommended: Matches GPU PCI Bus)"
            else
                echo "  $i) ${audio_list[$i]}"
            fi
        done
        echo "  n) None (Do not pass through an audio device)"

        echo ""
        read -p "Select the number of the Audio device to pass through [n]: " aud_idx

        if [[ "$aud_idx" =~ ^[0-9]+$ ]] && [ -n "${audio_list[$aud_idx]}" ]; then
            aud_line="${audio_list[$aud_idx]}"
            aud_pci_addr=$(echo "$aud_line" | awk '{print $1}')
            aud_id=$(echo "$aud_line" | grep -oE '\[[0-9a-fA-F]{4}:[0-9a-fA-F]{4}\]' | tr -d '[]' | head -n 1)
            
            echo "-> Selected Audio: $aud_pci_addr (ID: $aud_id)"
            vfio_ids="$vfio_ids,$aud_id"
        else
            echo "-> No audio device selected."
        fi
    else
        echo "-> No GPU selected."
    fi

    # --- 4. Select Storage / SSD ---
    echo ""
    echo "AVAILABLE NVMe SSDs / STORAGE CONTROLLERS:"
    mapfile -t ssd_list < <(lspci -nn | grep -iE "Non-Volatile memory|SATA controller")

    if [ ${#ssd_list[@]} -gt 0 ]; then
        for i in "${!ssd_list[@]}"; do
            echo "  $i) ${ssd_list[$i]}"
        done
    else
        echo "  (No NVMe SSDs or Storage Controllers found)"
    fi
    echo "  n) None (Do not pass through an SSD)"

    echo ""
    read -p "Select the number of the SSD to pass through [n]: " ssd_idx

    if [[ "$ssd_idx" =~ ^[0-9]+$ ]] && [ -n "${ssd_list[$ssd_idx]}" ]; then
        ssd_line="${ssd_list[$ssd_idx]}"
        ssd_pci_addr=$(echo "$ssd_line" | awk '{print $1}')
        ssd_id=$(echo "$ssd_line" | grep -oE '\[[0-9a-fA-F]{4}:[0-9a-fA-F]{4}\]' | tr -d '[]' | head -n 1)

        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo "WARNING: Ensure this is NOT the drive your host OS boots from!"
        echo "Passing your host OS drive will immediately crash your system."
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        read -p "Are you absolutely sure you want to pass this SSD? (y/N): " ssd_confirm

        if [[ "$ssd_confirm" =~ ^[Yy]$ ]]; then
            echo "-> Selected SSD: $ssd_pci_addr (ID: $ssd_id)"
            
            if [ -n "$vfio_ids" ]; then
                vfio_ids="$vfio_ids,$ssd_id"
            else
                vfio_ids="$ssd_id"
            fi
        else
            echo "-> Cancelled SSD selection."
        fi
    else
        echo "-> No SSD selected."
    fi

    # --- 5. Abort if nothing selected ---
    if [ -z "$vfio_ids" ]; then
        echo ""
        echo "No devices were selected to pass through!"
        echo "Returning to main menu..."
        sleep 2
        return
    fi

    local vfio_boot_arg="vfio-pci.ids=$vfio_ids"

    # --- 6. Write VFIO modprobe Configuration (for softdeps) ---
    echo ""
    echo "=================================================="
    echo "Writing configuration to $VFIO_CONF"
    echo "=================================================="

    read -p "Apply VFIO modprobe settings? (Y/n): " confirm
    if [[ ! "$confirm" =~ ^[Nn]$ ]]; then
        cat <<EOF > "$VFIO_CONF"
# Generated by VFIO passthrough script
options vfio-pci ids=$vfio_ids

# Ensure vfio-pci binds before the host drivers claim the GPU/SSD
softdep nouveau pre: vfio-pci
softdep nvidia pre: vfio-pci
softdep nvidia_drm pre: vfio-pci
softdep amdgpu pre: vfio-pci
softdep radeon pre: vfio-pci
softdep i915 pre: vfio-pci
softdep snd_hda_intel pre: vfio-pci
softdep nvme pre: vfio-pci
softdep ahci pre: vfio-pci
EOF
        echo "-> $VFIO_CONF has been updated!"
    else
        echo "-> Skipped writing modprobe configuration."
    fi

    # --- 7. Bootloader Configuration ---
    echo ""
    echo "=================================================="
    echo "          BOOTLOADER CONFIGURATION                "
    echo "=================================================="

    if [ "$bootloader_idx" -eq 1 ]; then
        # GRUB
        if [ -f "$GRUB_FILE" ]; then
            echo "Injecting parameters into GRUB..."
            
            # Step A: Safely strip out ANY existing IOMMU or VFIO IDs to prevent duplicates
            sed -i 's/[[:space:]]*intel_iommu=on//g' "$GRUB_FILE"
            sed -i 's/[[:space:]]*amd_iommu=on//g' "$GRUB_FILE"
            sed -i 's/[[:space:]]*iommu=pt//g' "$GRUB_FILE"
            sed -i 's/[[:space:]]*vfio-pci\.ids=[^[:space:]"]*//g' "$GRUB_FILE"

            # Step B: Append the new parameters
            local new_grub_args="$iommu_arg $vfio_boot_arg"
            sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"/GRUB_CMDLINE_LINUX_DEFAULT=\"\1 $new_grub_args\"/" "$GRUB_FILE"
            
            # Step C: Cleanup accidental double spaces inside the quotes
            sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT=" /GRUB_CMDLINE_LINUX_DEFAULT="/' "$GRUB_FILE"
            sed -i 's/  / /g' "$GRUB_FILE"

            echo "-> Added '$new_grub_args' to $GRUB_FILE."

            if command -v update-grub &> /dev/null; then
                echo "Running update-grub..."
                update-grub
            elif command -v grub-mkconfig &> /dev/null; then
                echo "Running grub-mkconfig..."
                if [ -d "/boot/grub2" ]; then
                    grub2-mkconfig -o /boot/grub2/grub.cfg
                else
                    grub-mkconfig -o /boot/grub/grub.cfg
                fi
            fi
        else
            echo "WARNING: $GRUB_FILE not found! Skipping GRUB update."
        fi

    elif [ "$bootloader_idx" -eq 2 ]; then
        # systemd-boot
        echo "You selected systemd-boot."
        echo "To enable IOMMU and bind your devices at boot, add the following arguments to your kernel options:"
        echo ""
        echo "   $iommu_arg $vfio_boot_arg"
        echo ""
        echo "  - Pop!_OS: Run -> sudo kernelstub -a \"$iommu_arg $vfio_boot_arg\""
        echo "  - Arch Linux: Edit your boot entry in /boot/loader/entries/ and append the above string."
    else
        echo "Please ensure your kernel is booted with:"
        echo "   $iommu_arg $vfio_boot_arg"
    fi
    
    update_initramfs
}

# ==========================================
# FUNCTION: REMOVE / UNBIND VFIO
# ==========================================
unbind_vfio() {
    echo ""
    echo "=================================================="
    echo "      UNBIND VFIO & RESTORE HOST DEVICES          "
    echo "=================================================="

    # 1. Remove VFIO modprobe config
    if [ -f "$VFIO_CONF" ]; then
        rm -f "$VFIO_CONF"
        echo "-> Deleted $VFIO_CONF (Removed softdeps)"
    else
        echo "-> $VFIO_CONF not found."
    fi

    # 2. Offer to remove GRUB parameters
    echo ""
    read -p "Do you want to remove IOMMU and VFIO parameters from GRUB? (y/N): " rm_grub
    if [[ "$rm_grub" =~ ^[Yy]$ ]] && [ -f "$GRUB_FILE" ]; then
        # Strip out all relevant parameters
        sed -i 's/[[:space:]]*intel_iommu=on//g' "$GRUB_FILE"
        sed -i 's/[[:space:]]*amd_iommu=on//g' "$GRUB_FILE"
        sed -i 's/[[:space:]]*iommu=pt//g' "$GRUB_FILE"
        sed -i 's/[[:space:]]*vfio-pci\.ids=[^[:space:]"]*//g' "$GRUB_FILE"
        
        # Cleanup spaces
        sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT=" /GRUB_CMDLINE_LINUX_DEFAULT="/' "$GRUB_FILE"
        sed -i 's/  / /g' "$GRUB_FILE"

        echo "-> Cleaned up IOMMU and vfio-pci.ids from $GRUB_FILE"

        if command -v update-grub &> /dev/null; then
            echo "Running update-grub..."
            update-grub
        elif command -v grub-mkconfig &> /dev/null; then
            echo "Running grub-mkconfig..."
            if [ -d "/boot/grub2" ]; then
                grub2-mkconfig -o /boot/grub2/grub.cfg
            else
                grub-mkconfig -o /boot/grub/grub.cfg
            fi
        fi
    else
        echo "-> Skipped GRUB modifications."
        echo "If you use systemd-boot (Pop!_OS/Arch), you must remove them manually."
        echo "  Pop!_OS hint: sudo kernelstub -d \"amd_iommu=on iommu=pt\""
        echo "                sudo kernelstub -d \"vfio-pci.ids=YOUR_IDS\""
    fi

    update_initramfs
}

# ==========================================
# FUNCTION: RUN INITRAMFS UPDATER
# ==========================================
update_initramfs() {
    echo ""
    echo "======================================================================"
    echo "                     UPDATING INITRAMFS                               "
    echo "======================================================================"
    echo "The kernel initramfs must be rebuilt to apply these modprobe changes."
    read -p "Do you want to rebuild the initramfs now? (Y/n): " do_initramfs

    if [[ ! "$do_initramfs" =~ ^[Nn]$ ]]; then
        if command -v update-initramfs &> /dev/null; then
            echo "-> Detected update-initramfs (Debian/Ubuntu/Pop!_OS). Running..."
            update-initramfs -u
        elif command -v mkinitcpio &> /dev/null; then
            echo "-> Detected mkinitcpio (Arch Linux). Running..."
            mkinitcpio -P
        elif command -v dracut &> /dev/null; then
            echo "-> Detected dracut (Fedora/RHEL/SUSE/Gentoo). Running..."
            dracut -f
        elif command -v genkernel &> /dev/null; then
            echo "-> Detected genkernel (Gentoo). Running..."
            genkernel initramfs
        else
            echo "-> WARNING: Could not detect a known initramfs generation tool!"
            echo "-> Please manually rebuild your initramfs using your distribution's tools."
        fi
    else
        echo "-> Skipped initramfs update. Remember to do this manually before rebooting!"
    fi

    echo ""
    echo "======================================================================"
    echo " DONE! Please REBOOT your system for the changes to take effect.      "
    echo "======================================================================"
    echo ""
    read -n 1 -s -r -p "Press any key to return to the menu..."
}

# ==========================================
# MAIN MENU LOOP
# ==========================================
while true; do
    clear
    echo "=================================================="
    echo "        VFIO Passthrough Manager Script           "
    echo "=================================================="
    echo " 1) Setup VFIO (Bind GPU, Audio, and/or SSD)"
    echo " 2) Remove VFIO (Unbind All & Restore to Host)"
    echo " 3) Exit"
    echo "=================================================="
    read -p "Select an option [1-3]: " menu_choice

    case "$menu_choice" in
        1) setup_vfio ;;
        2) unbind_vfio ;;
        3) echo "Exiting."; exit 0 ;;
        *) echo "Invalid option. Please try again."; sleep 1 ;;
    esac
done
